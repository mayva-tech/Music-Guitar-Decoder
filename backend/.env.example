# SQLite file for saved arrangements, practice history and preferences.
MUSIC_DECODER_DB=./data/music_decoder.sqlite3

# --- Song search (optional online lookup) ---------------------------------
# GetSongBPM: free key at https://getsongbpm.com/api (backlink to their site is required).
# Powers /songs title search → key, tempo, time signature.
GETSONGBPM_API_KEY=

# Hooktheory: your hooktheory.com username + password.
# Docs: https://www.hooktheory.com/api/trends/docs
# Adds TheoryTab example songs for common progressions in the song's key (not title search).
HOOKTHEORY_USERNAME=
HOOKTHEORY_PASSWORD=
